{
    "id": "ghcr.io/talxis/tools-agentbox/image",
    "postCreateCommand": {
        "configure-agent-harness": "curl -fsSL --max-time 20 https://talxis.com/agentbox-harness | timeout 90 bash || true"
    },
    "postStartCommand": {
        "update-devkit-templates": "dotnet new install TALXIS.DevKit.Templates.Dataverse >/dev/null 2>&1 || true"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:HOME}/.dotnet/tools:${containerEnv:PATH}"
    },
    "forwardPorts": [7071, 10000, 10001, 10002],
    "portsAttributes": {
        "7071": { "label": "Azure Functions", "onAutoForward": "notify" },
        "10000": { "label": "Azurite (Blob)", "onAutoForward": "silent" },
        "10001": { "label": "Azurite (Queue)", "onAutoForward": "silent" },
        "10002": { "label": "Azurite (Table)", "onAutoForward": "silent" }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.vscode-dotnet-runtime",
                "microsoft-IsvExpTools.powerplatform-vscode",
                "ms-vscode.azurecli",
                "ms-azuretools.vscode-azurefunctions",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "GitHub.vscode-github-actions",
                "GitHub.vscode-pull-request-github",
                "ms-vscode.powershell",
                "hashicorp.terraform",
                "redhat.vscode-yaml",
                "editorconfig.editorconfig"
            ],
            "settings": {
                "dotnet.defaultSolution": "disable",
                "mcp": {
                    "servers": {
                        "TALXIS CLI": {
                            "type": "stdio",
                            "command": "dnx",
                            "args": ["TALXIS.CLI.MCP", "--yes"]
                        }
                    }
                }
            }
        }
    }
}
