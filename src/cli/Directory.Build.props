<Project>
  <PropertyGroup>
    <!-- Placeholder: publish.yaml packs with -p:Version=<release version>, which also sets the
         package version and the version the CLI reports. -->
    <Version>0.0.1</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Company>TALXIS</Company>
    <Authors>NETWORG</Authors>
    <RepositoryUrl>https://github.com/TALXIS/tools-agentbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Banned API usage is a build error, as in tools-cli. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same rule set as tools-cli (src/BannedSymbols.txt): command code writes results through
         OutputFormatter and diagnostics through ILogger, never Console directly. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
